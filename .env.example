# ---- required ----------------------------------------------------------
# Your ElevenLabs API key (xi-api-key) and the agents-platform agent id.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ---- recommended -------------------------------------------------------
# A voice from YOUR account used to render probe phrases — ideally a clone
# of your own voice, because `say` cannot catch an ASR mishearing of YOU.
# Leave empty to fall back to the free macOS voice (PROBE_TTS=say forces it).
PROBE_VOICE_ID=

# Where the suite writes runs, fixtures, timeouts, and metrics.
# Default: ~/.aj-voice-agent
AJ_OUT=

# metrics.py only: your own cell number in E.164 (+1...). Separates real
# production calls from harness traffic; without it every call is excluded.
OWNER_NUMBER=

# metrics.py only, optional: path to your consult shim, so the dashboard can
# report which model answers check_notes.
CONSULT_SHIM=

# ---- template placeholders (filled in the files, not here) -------------
# agent/system-prompt.template.txt and agent/agent-config.template.json use
# {{DOUBLE_BRACE}} markers you replace before pasting into ElevenLabs:
#   {{USER_NAME}}       what she calls you
#   {{USER_FACTS}}      one line of who you are (job, city, tastes)
#   {{USER_TIMEZONE}}   IANA timezone, e.g. America/Los_Angeles
#   {{VOICE_ID}}        her voice, from your ElevenLabs voice library
#   {{AGENT_LLM}}       the agent LLM your account offers
#   {{TOOL_SERVER}}     https base URL that answers the 15 webhook tools
#   {{AGENT_ID}} / {{AGENT_PHONE}} / {{USER_PHONE}}   as labeled
